<launch>
    <!-- 加载参数文件 -->
    <rosparam file="$(find navi_map)/config/sim.yaml" command="load" />
    <arg name="navi_map/frame/mapFrame" default="map" />
    <arg name="navi_map/frame/pointcloudFrame" default="world" />
    <arg name="navi_map/sensor/height" default="0.397" />
    <arg name="navi_map/sensor/height_1" default="0.897" />



    <!-- 使用加载的参数 -->
    <node pkg="navi_map" type="read_pcd" name="readPCD" output="screen" />

    <node pkg="tf" type="static_transform_publisher" name="world_to_map" 
          args="0 0 $(arg navi_map/sensor/height) 0 0 0 $(arg navi_map/frame/mapFrame) $(arg navi_map/frame/pointcloudFrame) 100" />

    <node pkg="octomap_server" type="octomap_server_node" name="octomap_server" output="screen">
        <param name="resolution" value="0.05" />
        <param name="frame_id" value="$(arg navi_map/frame/mapFrame)" />
        <param name="base_frame_id" value="$(arg navi_map/frame/pointcloudFrame)" />
        <param name="latch" value="false" />
        <param name="pointcloud_min_z" value="-$(arg navi_map/sensor/height)" />
        <param name="pointcloud_max_z" value="1.2" />
        <!-- 上述输入后以地面为occupancy_z的0点进行下面的高度裁剪 -->
        <param name="occupancy_min_z" value="0.05"/>
        <param name="occupancy_max_z" value="$(arg navi_map/sensor/height_1)"/>
        <remap from="/cloud_in" to="/readpcd" />
    </node>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find navi_map)/rviz/map_maintain.rviz" />
</launch>
